global:
  smtp_smarthost: "${SMTP_HOST}"
  smtp_from: "${SMTP_FROM}"
  smtp_auth_username: "${SMTP_USER}"
  smtp_auth_password_file: "/run/secrets/smtp_password"
  smtp_require_tls: true

route:
  receiver: equipo
  group_by: [alertname, host, namespace]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: equipo
    email_configs:
      - to: "${ALERT_EMAIL}"
        send_resolved: true
